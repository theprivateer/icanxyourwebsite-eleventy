---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in collections.all %}{% if item.url and item.url != '/404.html' and item.url != '/feed.xml' and item.url != '/llms.txt' and item.url != '/manifest.webmanifest' and item.url != '/sitemap.xml' and item.url != '/.well-known/security.txt' %}
  <url>
    <loc>{{ item.url | absoluteUrl(site.url) }}</loc>{% if item.data.date %}
    <lastmod>{{ item.data.date | rfc3339Date }}</lastmod>{% endif %}
  </url>
{% endif %}{% endfor %}
</urlset>
